{ pkgs, nur, ... }: {
	services.sunshine = {
		enable = true;
		autoStart = true;
		capSysAdmin = true;
		openFirewall = true;
		settings = {
			sunshine_name = "celveza";
		};
		applications = {
			apps = [
				{
					name = "Jellyfin";
					cmd = "jellyfinmediaplayer --fullscreen --tv";
					detached = true;
					auto-detach = true;
					image-path = "/home/celveza/Pictures/jellyfn.png";
				}

				{
					name = "Desktop";
					image-path = "desktop.png";
				}
			];
		};
	};
}
